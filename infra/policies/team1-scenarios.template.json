{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageLabUsersAndPolicies",
      "Effect": "Allow",
      "Action": "iam:*",
      "Resource": [
        "arn:aws:iam::111122223333:user/iam-threat-monitor-lab-*",
        "arn:aws:iam::111122223333:policy/iam-threat-monitor-lab-*"
      ]
    },
    {
      "Sid": "BrowseIamForScenarioWork",
      "Effect": "Allow",
      "Action": [
        "iam:ListUsers",
        "iam:ListPolicies",
        "iam:GetPolicy",
        "iam:GetPolicyVersion"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadCloudTrailHistory",
      "Effect": "Allow",
      "Action": "cloudtrail:LookupEvents",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    }
  ]
}
