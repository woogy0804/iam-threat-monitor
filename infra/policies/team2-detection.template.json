{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectProjectEventRules",
      "Effect": "Allow",
      "Action": ["events:DescribeRule", "events:ListTargetsByRule"],
      "Resource": "arn:aws:events:us-east-1:111122223333:rule/iam-threat-monitor-*"
    },
    {
      "Sid": "TestAndUpdateProjectLambdaCode",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:GetPolicy",
        "lambda:InvokeFunction",
        "lambda:UpdateFunctionCode"
      ],
      "Resource": "arn:aws:lambda:us-east-1:111122223333:function:iam-threat-monitor-*"
    },
    {
      "Sid": "ReadProjectLambdaLogs",
      "Effect": "Allow",
      "Action": ["logs:DescribeLogStreams", "logs:GetLogEvents", "logs:FilterLogEvents"],
      "Resource": "arn:aws:logs:us-east-1:111122223333:log-group:/aws/lambda/iam-threat-monitor-*:*"
    },
    {
      "Sid": "InspectProjectStateAndAlerts",
      "Effect": "Allow",
      "Action": ["dynamodb:DescribeTable", "dynamodb:GetItem", "dynamodb:Query", "dynamodb:Scan"],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:111122223333:table/iam-threat-monitor-state",
        "arn:aws:dynamodb:us-east-1:111122223333:table/iam-threat-monitor-state/index/*",
        "arn:aws:dynamodb:us-east-1:111122223333:table/iam-threat-monitor-alerts",
        "arn:aws:dynamodb:us-east-1:111122223333:table/iam-threat-monitor-alerts/index/*"
      ]
    },
    {
      "Sid": "ListServicesForConsoleNavigation",
      "Effect": "Allow",
      "Action": ["events:ListEventBuses", "events:ListRules", "lambda:ListFunctions", "logs:DescribeLogGroups", "dynamodb:ListTables"],
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "us-east-1"}}
    }
  ]
}
